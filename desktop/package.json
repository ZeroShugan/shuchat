{
  "name": "shuchat-desktop",
  "productName": "ShuChat",
  "version": "0.9.0",
  "description": "ShuChat desktop app — Matrix client with calls, Voice & Video settings and global push-to-talk",
  "main": "main.js",
  "author": "Shugan",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "dev.shugan.shuchat",
    "productName": "ShuChat",
    "files": [
      "main.js",
      "preload.js",
      "keymap.js"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
