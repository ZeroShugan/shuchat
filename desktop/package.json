{
  "name": "shuchat-desktop",
  "productName": "ShuChat",
  "version": "0.9.19",
  "description": "ShuChat desktop app — Matrix client with calls, Voice & Video settings and global push-to-talk",
  "main": "main.js",
  "author": "Shugan",
  "license": "AGPL-3.0-only",
  "repository": "github:ZeroShugan/shuchat",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "dev.shugan.shuchat",
    "productName": "ShuChat",
    "afterPack": "./afterPack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "ZeroShugan",
        "repo": "shuchat"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "keymap.js",
      "picker-preload.js",
      "screenshare-picker.html"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "ShuChat-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "ShuChat-${version}.${ext}",
      "category": "Network",
      "maintainer": "zeroshugan@gmail.com"
    }
  }
}
